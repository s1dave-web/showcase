# Showcase Web settings - the one place everything is configured.
#
# EASIEST: you don't need to edit this file at all. Run `python app.py`, open
# http://<this-machine>:5005/screen/admin/ from your network, create a password,
# and use "Sign in with Plex". The settings page writes this file for you.
#
# If you'd rather edit by hand: copy this file to .env (the server also does that on first run).
# Never share your real .env - it holds your Plex token.
# A blank value means "use the default". Values may be quoted.

# ======================================================================
# CONNECTION - live, no restart needed (the settings page fills these in)
# ======================================================================

# Plex token and server address. Easiest via "Sign in with Plex" on the settings page.
# By hand: Plex Web > any movie > ... > Get Info > View XML > copy X-Plex-Token from the address bar.
PLEX_TOKEN=
PLEX_BASE_URL=
# Filled in by the settings page, for display only
PLEX_SERVER_NAME=
PLEX_SERVER_ID=
PLEX_USERNAME=

# Optional key screens must use: open the screensaver once as /screen/?key=<this value>.
# Strongly recommended if the server can be reached from the internet. The settings page can generate one.
SCREEN_ACCESS_KEY=

# How long (seconds) the server remembers your library list before asking Plex again
ITEM_CACHE_SECONDS=900

# ======================================================================
# SETTINGS PAGE SECURITY
# ======================================================================

# Hash of the settings-page password (never the password itself). Created on your first visit,
# or with:  python app.py --set-password
ADMIN_PASSWORD_HASH=

# The settings page only answers requests from your local network. Requests through a
# reverse proxy count as remote. Set to true to allow remote access (use HTTPS and a strong password).
ADMIN_ALLOW_REMOTE=false

# Generated automatically on first run. Changing SECRET_KEY signs everyone out (restart needed).
SECRET_KEY=
PLEX_CLIENT_ID=

# Where this server listens (restart needed)
HOST=0.0.0.0
PORT=5005

# ======================================================================
# LIBRARY & DISPLAY - live: screens pick up changes within about a minute
# ======================================================================

# Library names to skip, comma-separated. Music and photo libraries are always skipped.
LIBRARIES_TO_EXCLUDE=

# Seconds each image stays on screen, and how long the crossfade takes (0 = instant)
IMAGE_INTERVAL_SECONDS=10
TRANSITION_SECONDS=1.5

# original = full-quality artwork as stored in Plex (4K where Plex has it)
# screen   = Plex shrinks it to the screen size first (for slow Wi-Fi / weak devices)
ART_QUALITY=original

# Motion effects, picked at random per image; "none" for no motion.
# Available: zoomIn,zoomOut,moveRight,moveLeft,moveUp,moveDown,goGray,goColor
ANIMATIONS=zoomIn,zoomOut,moveRight,moveLeft,moveUp,moveDown,goGray,goColor

# Title (bottom of screen). Position: left / center / right. Colour: #hex, rgb(...) or a name like white.
# Note: "left" sits over the corner poster - turn SHOW_POSTER off with it.
SHOW_TITLE=true
TITLE_COLOR=#ffffff
TITLE_OPACITY=0.8
TITLE_POSITION=right

# Clock (top of screen)
SHOW_TIME=true
TIME_COLOR=#ffffff
TIME_OPACITY=0.8
TIME_POSITION=right
CLOCK_24H=true

# Small poster in the bottom-left corner
SHOW_POSTER=true

# Moves the clock/title a few pixels with each image so they can't burn into OLED screens
PIXEL_SHIFT=true

# How often (minutes) screens re-fetch the library list to pick up new Plex items
REFRESH_MINUTES=30

# Show Plex artwork at all (false = only your extra images below)
USE_PLEX=true

# Extra images to mix in, as Title|file;Title|file
# Local files go in static/extraImages/   e.g.  EXTRA_IMAGES=Holiday|beach.jpg;Family|xmas.jpg
EXTRA_IMAGES=
# Images from the web                      e.g.  EXTRA_LINKS=Space|https://example.com/nebula.jpg
EXTRA_LINKS=
